{
  "name": "3d-photo-grid",
  "version": "1.2.1",
  "description": "A blank template to get started with Payload 3.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap --config src/payload.config.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types --config src/payload.config.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:dev:up": "docker compose up -d postgres",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate --config src/payload.config.ts",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create --config src/payload.config.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed:how-it-works": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/updateHomeHowItWorksSteps.ts",
    "seed:blogs:draft": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seedDraftBlogs.ts",
    "seed:blogs:draft:live": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx src/scripts/seedDraftBlogs.ts --live",
    "encrypt:sensitive-content": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/encryptSensitiveContent.ts",
    "encrypt:sensitive-content:live": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx src/scripts/encryptSensitiveContent.ts --live",
    "legacy:checkins": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/runLegacyCheckIns.ts",
    "digital-legacy:reset": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/resetDigitalLegacyChecklists.ts",
    "admin-email-campaigns:run": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/runAdminEmailCampaigns.ts",
    "predev": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/prepareCommunityDatabase.ts"
  },
  "dependencies": {
    "@payloadcms/db-vercel-postgres": "^3.84.1",
    "@payloadcms/email-resend": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "@react-pdf/renderer": "^4.6.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.14.1",
    "next": "^15.5.18",
    "next-intl": "^4.11.2",
    "payload": "^3.84.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-joyride": "^3.0.2",
    "sharp": "0.34.2",
    "three": "^0.180.0",
    "@payloadcms/storage-s3": "3.84.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.18",
    "jsdom": "26.1.0",
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "^9 || ^10"
  },
  "overrides": {
    "esbuild": "0.28.0",
    "postcss": "$postcss",
    "uuid": "14.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
