NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=change-me
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/memoryvault

# S3-compatible object storage for media uploads.
# Recommended hosted option: Cloudflare R2.
# Fully self-hosted option: MinIO.
S3_BUCKET=memoryvault
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=Memory Vault
APP_ENCRYPTION_KEY=
CRON_SECRET=
