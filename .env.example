NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=change-me
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/memoryvault

# Media storage. STORAGE_DRIVER picks the backend explicitly: local | s3 | vercel-blob
# Leave it unset to auto-detect from whichever credentials below are set, or to
# fall back to local disk storage (no setup needed) if none are.
STORAGE_DRIVER=local

# --- s3: any S3-compatible object storage. ---
# Recommended hosted options: Amazon S3, Cloudflare R2. Fully self-hosted: MinIO.
S3_BUCKET=memoryvault
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- vercel-blob: only needed if STORAGE_DRIVER=vercel-blob (or left unset
# and this is the only storage credential present). Get this from your
# Vercel project's Blob store settings.
BLOB_READ_WRITE_TOKEN=

RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=Memory Vault
APP_ENCRYPTION_KEY=
CRON_SECRET=
